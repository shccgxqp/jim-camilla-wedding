{
  "name": "jim-camilla-wedding",
  "version": "1.0.0",
  "description": "Jim & Camilla wedding site with iPad photo booth, server-side photo storage, and QR downloads.",
  "main": "server.cjs",
  "scripts": {
    "start": "node server.cjs",
    "dev": "concurrently \"vite\" \"nodemon server.cjs\"",
    "build": "vite build",
    "cf:dev": "npm run build && wrangler dev",
    "cf:deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "gif-encoder-2": "^1.0.5",
    "gifenc": "^1.0.3",
    "jpeg-js": "^0.4.4",
    "mediabunny": "^1.50.8",
    "omggif": "^1.0.10",
    "pngjs": "^7.0.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.16.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9",
    "nodemon": "^3.1.14",
    "tailwindcss": "^4",
    "vite": "^6",
    "wrangler": "^4.110.0"
  }
}
